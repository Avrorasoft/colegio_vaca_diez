{% extends "base.html" %}

{% block title %}
Escanear Documento - Colegio Dr. Antonio Vaca Díez
{% endblock %}

{% block content %}
<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-camera-fill text-info"></i>
                Escanear Documento (OCR)
            </h4>

            <a href="{{ url_for('archivos.lista_egresados') }}"
               class="btn btn-sm btn-light">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>

        <div class="card-body">

            <!-- =============================================================== -->
            <!-- INSTRUCCIONES -->
            <!-- =============================================================== -->

            <div class="alert alert-info">
                <i class="bi bi-info-circle-fill"></i>
                Tome una fotografía clara del documento (diploma, boletín o carnet)
                desde su celular o computadora.
                El sistema aplicará <strong>Inteligencia Artificial (OCR)</strong>
                para extraer el texto y autocompletar el formulario de registro
                del egresado.
            </div>

            <!-- =============================================================== -->
            <!-- FORMULARIO DE ESCANEO -->
            <!-- =============================================================== -->

            <form method="POST" enctype="multipart/form-data">

                <div class="row mb-4">
                    <div class="col-md-6">

                        <label class="form-label">
                            Fotografía del Documento *
                        </label>

                        <!-- capture="environment" abre la cámara directo en el celular -->
                        <input type="file"
                               name="imagen_documento"
                               class="form-control"
                               accept="image/*"
                               capture="environment"
                               required>

                        <small class="text-muted">
                            Formatos: JPG, PNG.
                            Se recomienda buena iluminación y texto legible.
                        </small>

                    </div>
                </div>

                <!-- =========================================================== -->
                <!-- BOTONES -->
                <!-- =========================================================== -->

                <div class="d-flex justify-content-between">

                    <a href="{{ url_for('archivos.lista_egresados') }}"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-info">
                        <i class="bi bi-upc-scan"></i> Escanear y Extraer Texto
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>
{% endblock %}