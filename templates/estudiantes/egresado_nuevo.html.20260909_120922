{% extends "base.html" %}
{% block title %}Registro de Nuevo Egresado - Cárdex Académico{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-0 text-dark">🎓 Registro de Nuevo Egresado</h3>
            <small class="text-muted">Colegio Dr. Antonio Vaca Díez | Apertura de Cárdex Institucional y Académico</small>
        </div>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Cancelar y Volver
        </a>
    </div>

    <form method="POST" action="{{ url_for('estudiantes.nuevo_egresado') }}" class="needs-validation">
        <!-- 1. DATOS DE IDENTIFICACIÓN Y FILIACIÓN PERSONAL -->
        <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px;">
            <div class="card-header bg-dark text-white fw-bold py-2">
                1. Datos de Identificación y Filiación Personal
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Cédula de Identidad (C.I.) *</label>
                        <input type="text" name="ci" class="form-control" placeholder="Ej. 6859403" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Expedido</label>
                        <select name="expedido" class="form-select">
                            <option value="BN" selected>BN (Beni)</option>
                            <option value="PD">PD (Pando)</option>
                            <option value="LP">LP (La Paz)</option>
                            <option value="SC">SC (Santa Cruz)</option>
                            <option value="CB">CB (Cochabamba)</option>
                            <option value="CH">CH (Chuquisaca)</option>
                            <option value="OR">OR (Oruro)</option>
                            <option value="PT">PT (Potosí)</option>
                            <option value="TJ">TJ (Tarija)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Código RUDE *</label>
                        <input type="text" name="rude" class="form-control" placeholder="Código RUDE Ministerial" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Fecha de Nacimiento</label>
                        <input type="date" name="fecha_nacimiento" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Apellidos *</label>
                        <input type="text" name="apellidos" class="form-control text-uppercase" placeholder="Apellidos completos" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nombres *</label>
                        <input type="text" name="nombres" class="form-control text-uppercase" placeholder="Nombres completos" required>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Género / Sexo</label>
                        <select name="sexo" class="form-select">
                            <option value="Masculino">Masculino</option>
                            <option value="Femenino">Femenino</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Teléfono / WhatsApp</label>
                        <input type="text" name="telefono" class="form-control" placeholder="N° Celular de contacto">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Dirección de Domicilio</label>
                        <input type="text" name="direccion" class="form-control" placeholder="Barrio, Calle, N° en Riberalta">
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. DATOS DE APODERADO / FAMILIAR DE CONTACTO -->
        <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px;">
            <div class="card-header bg-secondary text-white fw-bold py-2">
                2. Datos de Referencia Familiar / Tutor
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nombre del Padre / Madre / Tutor</label>
                        <input type="text" name="nombre_tutor" class="form-control text-uppercase" placeholder="Nombre completo">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">C.I. Tutor</label>
                        <input type="text" name="ci_tutor" class="form-control" placeholder="N° Documento">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Celular de Referencia</label>
                        <input type="text" name="telefono_tutor" class="form-control" placeholder="Contacto de emergencia">
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. CÁRDEX ACADÉMICO DE EGRESO -->
        <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px;">
            <div class="card-header text-white fw-bold py-2" style="background-color: #0f172a;">
                3. Información Académica y Documental de Egreso
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Gestión / Año de Egreso *</label>
                        <input type="number" name="anio_egreso" class="form-control fw-bold text-primary" value="2026" min="1990" max="2050" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Turno que Cursó *</label>
                        <select name="turno_egreso" class="form-select fw-semibold" required>
                            <option value="Mañana" selected>🌅 Turno Mañana</option>
                            <option value="Tarde">🌇 Turno Tarde</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Último Paralelo Cursado</label>
                        <input type="text" name="curso_egreso" class="form-control" value="6to de Secundaria" readonly>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Promedio General de Egreso</label>
                        <input type="number" step="0.01" min="0" max="100" name="promedio_egreso" class="form-control fw-bold" placeholder="Sobre 100 pts">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Modalidad de Bachillerato (BTH)</label>
                        <select name="modalidad_bth" class="form-select">
                            <option value="Humanístico Regular" selected>Humanístico Regular</option>
                            <option value="Técnico Medio en Sistemas">Técnico Medio en Sistemas</option>
                            <option value="Técnico Medio en Contabilidad">Técnico Medio en Contabilidad</option>
                            <option value="Técnico Medio en Secretariado">Técnico Medio en Secretariado</option>
                            <option value="Otra Especialidad">Otra Especialidad Técnica</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">N° Diploma de Bachiller / Título</label>
                        <input type="text" name="nro_diploma" class="form-control" placeholder="N° de Registro Ministerial">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Folio / N° de Libro de Registro</label>
                        <input type="text" name="libro_registro" class="form-control" placeholder="Libro y Folio institucional">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Distinciones / Méritos / Cuadro de Honor</label>
                        <input type="text" name="distinciones" class="form-control" placeholder="Ej. Abanderado, Primer Lugar en Rendimiento, Excelencia Deportiva">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Observaciones Generales de Egreso</label>
                        <textarea name="observaciones" class="form-control" rows="2" placeholder="Observaciones complementarias del cárdex del egresado..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTÓN DE ENVÍO -->
        <div class="d-flex justify-content-end gap-2 pb-4">
            <a href="javascript:history.back()" class="btn btn-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4 fw-bold">
                💾 Guardar Cárdex de Egresado
            </button>
        </div>
    </form>
</div>
{% endblock %}
