<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Recibo de Pago #{{ pago.id }} - {{ est.apellidos }} {{ est.nombres }}</title>
    <style>
        @page { size: letter portrait; margin: 15mm; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #1e293b; margin: 0; padding: 20px; font-size: 13px; }
        .comprobante { border: 2px solid #0f172a; border-radius: 8px; padding: 25px; max-width: 680px; margin: 0 auto; background: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
        .header { border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; }
        .header h2 { margin: 0; font-size: 18px; text-transform: uppercase; color: #0f172a; }
        .header p { margin: 2px 0 0; color: #475569; font-size: 11px; }
        .badge-folio { background: #0f172a; color: #fff; padding: 6px 12px; border-radius: 4px; font-weight: bold; font-size: 13px; text-align: right; }
        .grid-datos { display: grid; grid-template-columns: 1.2fr 1fr; gap: 12px; margin-bottom: 20px; padding: 12px; background: #f8fafc; border-radius: 6px; border: 1px solid #e2e8f0; }
        .label { font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: bold; display: block; }
        .valor { font-weight: 600; font-size: 13px; color: #0f172a; }
        .turno-badge { display: inline-block; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 12px; }
        .turno-manana { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
        .turno-tarde { background: #e0f2fe; color: #075985; border: 1px solid #bae6fd; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th { background: #0f172a; color: #fff; padding: 8px 10px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
        td { padding: 10px; border-bottom: 1px solid #cbd5e1; }
        .total-box { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; background: #f1f5f9; border-radius: 6px; font-size: 15px; font-weight: bold; margin-bottom: 30px; border: 1px solid #cbd5e1; }
        .firmas { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; text-align: center; font-size: 11px; color: #475569; margin-top: 45px; }
        .linea-firma { border-top: 1px dashed #64748b; padding-top: 5px; width: 85%; margin: 0 auto; }
        .no-print { text-align: center; margin-bottom: 20px; }
        .btn-print { background: #0284c7; color: white; border: none; padding: 10px 20px; font-size: 14px; font-weight: bold; border-radius: 5px; cursor: pointer; }
        @media print { .no-print { display: none; } body { padding: 0; } .comprobante { border: 1px solid #000; box-shadow: none; padding: 15px; } }
    </style>
</head>
<body>
    <div class="no-print">
        <button class="btn-print" onclick="window.print()">🖨️ Imprimir Recibo Oficial</button>
        <button class="btn-print" style="background:#64748b; margin-left: 10px;" onclick="window.close()">Cerrar</button>
    </div>

    <div class="comprobante">
        <div class="header">
            <div>
                <h2>Colegio Dr. Antonio Vaca Díez</h2>
                <p>Sistema Integrado de Gestión Institucional | Riberalta - Beni</p>
                <p style="font-weight: bold; color: #0284c7;">COMPROBANTE OFICIAL DE COBRO EN CAJA</p>
            </div>
            <div class="badge-folio">
                RECIBO #{{ pago.id }}
            </div>
        </div>

        <div class="grid-datos">
            <div>
                <span class="label">Estudiante</span>
                <span class="valor">{{ est.apellidos }}, {{ est.nombres }}</span>
                <span class="label" style="margin-top: 8px;">Curso / Grado</span>
                <span class="valor">{{ est.curso or 'No asignado' }}</span>
                <span class="label" style="margin-top: 8px;">Tutor / Apoderado</span>
                <span class="valor">{{ padre.nombre if padre else 'No registrado' }}</span>
            </div>
            <div>
                <span class="label">Fecha y Hora</span>
                <span class="valor">{{ pago.fecha_pago.strftime('%d/%m/%Y %H:%M') if pago.fecha_pago else now().strftime('%d/%m/%Y %H:%M') }}</span>
                
                <!-- IDENTIFICACIÓN DEL TURNO DEL CAJERO -->
                <span class="label" style="margin-top: 8px;">Turno del Cajero Receptor</span>
                <div style="margin-top: 2px;">
                    {% set turno_actual = (pago.turno or 'Mañana')|lower %}
                    {% if 'tarde' in turno_actual %}
                        <span class="turno-badge turno-tarde">🌇 TURNO TARDE</span>
                    {% else %}
                        <span class="turno-badge turno-manana">🌅 TURNO MAÑANA</span>
                    {% endif %}
                </div>

                <span class="label" style="margin-top: 8px;">Método de Pago</span>
                <span class="valor">{{ pago.metodo_pago or 'Efectivo' }}</span>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="text-align: left;">Descripción / Concepto</th>
                    <th style="text-align: center;">Mes / Gestión</th>
                    <th style="text-align: center;">Turno Caja</th>
                    <th style="text-align: right;">Importe Cancelado</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <strong>{{ pago.concepto or 'Pensión Escolar' }}</strong>
                        {% if pago.observacion %}
                        <br><small style="color: #64748b;">Obs: {{ pago.observacion }}</small>
                        {% endif %}
                    </td>
                    <td style="text-align: center;">{{ pago.mes or '-' }} / {{ pago.anio or '-' }}</td>
                    <td style="text-align: center; font-weight: 600;">
                        {% if 'tarde' in (pago.turno or '')|lower %}
                            Tarde
                        {% else %}
                            Mañana
                        {% endif %}
                    </td>
                    <td style="text-align: right; font-weight: bold; font-size: 14px;">Bs. {{ "%.2f"|format(pago.monto_pagado or 0) }}</td>
                </tr>
            </tbody>
        </table>

        <div class="total-box">
            <span>TOTAL PERCIBIDO EN ESTA OPERACIÓN:</span>
            <span style="color: #059669; font-size: 18px;">Bs. {{ "%.2f"|format(pago.monto_pagado or 0) }}</span>
        </div>

        <div class="firmas">
            <div>
                <div class="linea-firma">
                    <strong>Cajero Responsable</strong><br>
                    {% if 'tarde' in (pago.turno or '')|lower %}
                        Caja - Turno Tarde
                    {% else %}
                        Caja - Turno Mañana
                    {% endif %}
                </div>
            </div>
            <div>
                <div class="linea-firma">
                    <strong>Firma Tutor / Depositante</strong><br>
                    CI: {{ padre.ci if padre and padre.ci else '........................' }}
                </div>
            </div>
        </div>
    </div>
</body>
</html>
