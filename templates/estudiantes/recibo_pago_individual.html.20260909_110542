<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Recibo de Pago #{{ pago.id }} - {{ est.apellidos }} {{ est.nombres }}</title>
    <style>
        @page { size: letter portrait; margin: 15mm; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #1e293b; margin: 0; padding: 20px; font-size: 13px; }
        .comprobante { border: 2px solid #0f172a; border-radius: 8px; padding: 25px; max-width: 680px; margin: 0 auto; background: #fff; }
        .header { border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; }
        .header h2 { margin: 0; font-size: 18px; text-transform: uppercase; color: #0f172a; }
        .header p { margin: 2px 0 0; color: #475569; font-size: 11px; }
        .folio-badge { background: #0f172a; color: #fff; padding: 6px 12px; border-radius: 4px; font-weight: bold; font-size: 13px; }
        .grid-datos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; padding: 10px; background: #f8fafc; border-radius: 6px; border: 1px solid #e2e8f0; }
        .grid-datos div { line-height: 1.4; }
        .label { font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: bold; display: block; }
        .valor { font-weight: 600; font-size: 13px; color: #0f172a; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th { background: #0f172a; color: #fff; padding: 8px 10px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
        td { padding: 10px; border-bottom: 1px solid #cbd5e1; }
        .total-box { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; background: #f1f5f9; border-radius: 6px; font-size: 15px; font-weight: bold; margin-bottom: 35px; border: 1px solid #cbd5e1; }
        .firmas { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; text-align: center; font-size: 11px; color: #475569; margin-top: 50px; }
        .linea-firma { border-top: 1px dashed #64748b; padding-top: 5px; width: 80%; margin: 0 auto; }
        .no-print { text-align: center; margin-bottom: 20px; }
        .btn-print { background: #0284c7; color: white; border: none; padding: 10px 20px; font-size: 14px; font-weight: bold; border-radius: 5px; cursor: pointer; }
        @media print { .no-print { display: none; } body { padding: 0; } .comprobante { border: 1px solid #000; padding: 15px; } }
    </style>
</head>
<body>
    <div class="no-print">
        <button class="btn-print" onclick="window.print()">🖨️ Imprimir Este Recibo</button>
        <button class="btn-print" style="background:#64748b; margin-left: 10px;" onclick="window.close()">Cerrar</button>
    </div>

    <div class="comprobante">
        <div class="header">
            <div>
                <h2>Colegio Dr. Antonio Vaca Díez</h2>
                <p>Sistema Integrado de Gestión Institucional | Riberalta - Beni</p>
                <p><strong>COMPROBANTE DE COBRO INDIVIDUAL</strong></p>
            </div>
            <div class="folio-badge">
                RECIBO #{{ pago.id }}
            </div>
        </div>

        <div class="grid-datos">
            <div>
                <span class="label">Estudiante</span>
                <span class="valor">{{ est.apellidos }}, {{ est.nombres }}</span>
                <span class="label" style="margin-top: 6px;">Curso / Nivel</span>
                <span class="valor">{{ est.curso or 'No asignado' }}</span>
            </div>
            <div>
                <span class="label">Fecha y Hora de Pago</span>
                <span class="valor">{{ pago.fecha_pago.strftime('%d/%m/%Y %H:%M') if pago.fecha_pago else 'Fecha no registrada' }}</span>
                <span class="label" style="margin-top: 6px;">Cajero / Turno</span>
                <span class="valor">{{ pago.turno or 'Caja Central' }}</span>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="text-align: left;">Descripción / Concepto</th>
                    <th style="text-align: center;">Mes / Año</th>
                    <th style="text-align: center;">Método</th>
                    <th style="text-align: right;">Monto Cancelado</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <strong>{{ pago.concepto or 'Pensión Mensual' }}</strong>
                        {% if pago.observacion %}
                        <br><small style="color: #64748b;">Obs: {{ pago.observacion }}</small>
                        {% endif %}
                    </td>
                    <td style="text-align: center;">{{ pago.mes or '-' }} / {{ pago.anio or '-' }}</td>
                    <td style="text-align: center;">{{ pago.metodo_pago or 'Efectivo' }}</td>
                    <td style="text-align: right; font-weight: bold; font-size: 14px;">Bs. {{ "%.2f"|format(pago.monto_pagado or 0) }}</td>
                </tr>
            </tbody>
        </table>

        <div class="total-box">
            <span>TOTAL CANCELADO EN ESTA TRANSACCIÓN:</span>
            <span style="color: #047857; font-size: 17px;">Bs. {{ "%.2f"|format(pago.monto_pagado or 0) }}</span>
        </div>

        <div class="firmas">
            <div>
                <div class="linea-firma">Cajero Responsable<br>Turno: {{ pago.turno or 'Caja' }}</div>
            </div>
            <div>
                <div class="linea-firma">Firma Padre / Tutor / Apoderado<br>CI: {{ padre.ci if padre else '.....................' }}</div>
            </div>
        </div>
    </div>
</body>
</html>
