{% extends "base.html" %}

{% block title %}Nuevo Egresado - Cardex{% endblock %}

{% block content %}
<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-mortarboard-fill"></i>
                Registro de Cardex - Nuevo Egresado
            </h4>

            <a href="{{ url_for('archivos.lista_egresados') }}"
               class="btn btn-sm btn-light">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>

        <div class="card-body">

            <!-- =============================================================== -->
            <!-- MENSAJE OCR -->
            <!-- =============================================================== -->

            {% if texto_sugerido %}
            <div class="alert alert-success">
                <strong>
                    <i class="bi bi-check-circle-fill"></i>
                    ¡Escaneo OCR exitoso!
                </strong>
                <br>
                El sistema ha procesado la lectura desde el teléfono y autocompletará los campos detectados.

                <pre class="mt-2 p-2 bg-light border rounded"
                     style="max-height:200px; overflow-y:auto; white-space:pre-wrap;">{{ texto_sugerido }}</pre>
            </div>
            {% endif %}

            <form method="POST" enctype="multipart/form-data">

                <!-- =============================================================== -->
                <!-- FOTOGRAFÍA -->
                <!-- =============================================================== -->

                <div class="row mb-4">
                    <div class="col-md-4">
                        <h5>Fotografía (Boletín)</h5>

                        <input type="file"
                               name="foto_alumno"
                               class="form-control"
                               accept="image/*">

                        <small class="text-muted">
                            Formato perfil oficial
                        </small>

                        <div class="alert alert-info mt-2 small">
                            <i class="bi bi-info-circle"></i>
                            Esta imagen se vinculará al Cardex y se utilizará dinámicamente
                            al generar el Boletín PDF.
                        </div>
                    </div>
                </div>

                <hr>

                <!-- =============================================================== -->
                <!-- INFORMACIÓN ACADÉMICA Y PERSONAL -->
                <!-- =============================================================== -->

                <h5>Información Académica y Personal</h5>

                <div class="row">

                    <!-- ⭐ C.I. CON AUTOCOMPLETADO OCR -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            C.I. del Egresado *
                        </label>

                        <input type="text"
                               name="ci"
                               class="form-control"
                               value="{{ datos.ci if datos else '' }}"
                               placeholder="Carnet de Identidad"
                               required>
                    </div>

                    <!-- ⭐ RUDE CON AUTOCOMPLETADO OCR -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            Código RUDE (informativo)
                        </label>

                        <input type="text"
                               name="rude"
                               class="form-control"
                               value="{{ datos.rude if datos else '' }}"
                               placeholder="Opcional">
                    </div>

                    <!-- ⭐ GESTIÓN CON AUTOCOMPLETADO OCR -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            Gestión de Egreso *
                        </label>

                        <input type="number"
                               name="anio_egreso"
                               class="form-control"
                               value="{{ datos.anio_egreso if datos and datos.anio_egreso else anio_actual }}"
                               min="1985"
                               max="{{ anio_actual + 1 }}"
                               required>
                    </div>

                    <!-- ⭐ NOMBRES CON AUTOCOMPLETADO OCR -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Nombres *
                        </label>

                        <input type="text"
                               name="nombres"
                               class="form-control"
                               value="{{ datos.nombres if datos else '' }}"
                               required>
                    </div>

                    <!-- ⭐ APELLIDOS CON AUTOCOMPLETADO OCR -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Apellidos *
                        </label>

                        <input type="text"
                               name="apellidos"
                               class="form-control"
                               value="{{ datos.apellidos if datos else '' }}"
                               required>
                    </div>

                    <!-- ⭐ CURSO FINAL CON AUTOCOMPLETADO OCR -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            Curso Final *
                        </label>

                        <select name="curso_final" class="form-select" required>
                            <option value="">Seleccione un curso...</option>

                            {% for curso in cursos %}
                            <option value="{{ curso }}"
                                {% if datos and datos.curso_final == curso %}selected{% endif %}>
                                {{ curso }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- ⭐ ESTADO DE EGRESO -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            Estado de Egreso *
                        </label>

                        <select name="estado_egreso" class="form-select" required>
                            <option value="Graduado" selected>Graduado</option>
                            <option value="No Graduado">No Graduado</option>
                            <option value="Retirado">Retirado</option>
                            <option value="Trasladado">Trasladado</option>
                        </select>
                    </div>

                </div>

                <hr>

                <!-- =============================================================== -->
                <!-- DATOS DEL TUTOR -->
                <!-- =============================================================== -->

                <h5>Datos del Tutor (Opcional)</h5>

                <div class="row">
                    <!-- ⭐ TUTOR CON AUTOCOMPLETADO OCR -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Nombre del Tutor
                        </label>

                        <input type="text"
                               name="nombre_tutor"
                               class="form-control"
                               value="{{ datos.nombre_tutor if datos else '' }}"
                               placeholder="Opcional">
                    </div>

                    <!-- ⭐ TELÉFONO CON AUTOCOMPLETADO OCR -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Teléfono del Tutor
                        </label>

                        <input type="text"
                               name="telefono_tutor"
                               class="form-control"
                               value="{{ datos.telefono_tutor if datos else '' }}"
                               placeholder="Opcional">
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-3">

                    <a href="{{ url_for('archivos.lista_egresados') }}"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Guardar Cardex
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>
{% endblock %}